# Copy to .env at the repository root. The API reads this file; the web app does not.

NODE_ENV=development
PORT=4000

# --- Sign-in (required) -------------------------------------------------------
# The admin's password, typed on the admin sign-in page at /admin. Everyone else signs in on the
# main page with the username and 6-digit PIN the admin gives them.
AUTH_PASSWORD=choose-a-long-password
# At least 32 random characters, used to sign session tokens and to pepper listener PINs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing AUTH_PASSWORD or AUTH_SECRET signs out every device. Changing AUTH_SECRET also makes
# every listener's PIN stop working, so the admin has to give each of them a new one.
AUTH_SECRET=replace-with-at-least-32-random-characters
# How long a sign-in lasts.
AUTH_TOKEN_TTL_DAYS=30

# --- Database (Neon Postgres) -------------------------------------------------
# Migrations in database/schema run automatically when the API starts.
DATABASE_URL=postgresql://neondb_owner:your-password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Backblaze B2 (S3-compatible API) -----------------------------------------
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET_NAME=personal-mp3-player
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
# Signed playback/artwork links stay valid for between 1x and 2x this long.
B2_SIGNED_URL_TTL_SECONDS=3600
# How long the browser has to start an upload after asking for an upload link.
B2_UPLOAD_URL_TTL_SECONDS=900

# --- Uploads ------------------------------------------------------------------
UPLOAD_MAX_SIZE_MB=100

# --- Deployment (optional) ----------------------------------------------------
# Comma-separated origins allowed to call the API from a browser, e.g. your Vercel URL.
# Empty allows any origin, which is safe here because every request needs a bearer token.
CORS_ORIGINS=
# Proxy hops in front of the API, so rate limiting sees real client IPs.
# Defaults to 1 when NODE_ENV=production (Render, Vercel), otherwise 0.
TRUST_PROXY=

# --- Web app ------------------------------------------------------------------
# Set VITE_API_BASE_URL in the web app's environment (apps/web/.env or Vercel), not here.
# Leave it unset in development: Vite proxies /api to http://localhost:4000.
# VITE_API_BASE_URL=https://your-api.onrender.com/api
